{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SieveSci",
  "version": "0.2.5",
  "identifier": "app.sievesci.SieveSci",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SieveSci",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src 'self' data:; object-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "A research agent for biology and chemistry",
    "copyright": "© 2026 王鹤年",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Russian",
          "Spanish",
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyODg0QjJDRDU2QkJEODIKUldTQ3ZXdlZMRXVJd2cwdzdPUXdqL2ZvRXRPS1hoYmcxZzVuYVFxK2FIK29OSHpFMUhEOFlYblQK",
      "endpoints": [
        "https://github.com/Cetirzine/SieveSci/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
